{
  "name": "commently",
  "version": "1.0.0",
  "description": "Self-hosted comments-as-a-service",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --forceExit --detectOpenHandles",
    "test:unit": "npm test -- --testPathPattern='tests/unit'",
    "test:integration": "npm test -- --testPathPattern='tests/integration'"
  },
  "keywords": ["comments", "api", "multi-tenant"],
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  }
}
